# ============================================================
# CognoDB Cloud
# ============================================================
COGNODB_URI=bolt+s://YOUR_COGNODB_INSTANCE
COGNODB_USER=cognodb
COGNODB_PASSWORD=YOUR_COGNODB_PASSWORD

# ============================================================
# Neo4j AuraDB
# ============================================================
NEO4J_URI=neo4j+s://YOUR_NEO4J_INSTANCE
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# ============================================================
# FalkorDB Cloud
# ============================================================
FALKORDB_HOST=YOUR_FALKORDB_HOST
FALKORDB_PORT=YOUR_FALKORDB_PORT
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=YOUR_FALKORDB_PASSWORD

# ============================================================
# Memgraph Cloud
# ============================================================
MEMGRAPH_URI=bolt+ssc://YOUR_MEMGRAPH_HOST:7687
MEMGRAPH_USER=YOUR_MEMGRAPH_USER
MEMGRAPH_PASSWORD=YOUR_MEMGRAPH_PASSWORD

# ============================================================
# ArangoDB Managed Platform
# ============================================================
ARANGO_URL=https://YOUR_ARANGODB_HOST:8529
ARANGO_USER=root
ARANGO_PASSWORD=YOUR_ARANGODB_PASSWORD
ARANGO_DATABASE=wexa_benchmark
